<!-- The HUD, which Lamplight.as fills from the level. The target and what has been taken sit top
     left, a word shows in the middle for a moment (a checkpoint reached, or the exit reached
     without the target), and the time sits top right. Along the foot, what the thief can do here
     (put out a lamp, pick a lock: Lamp.as, Door.as) shows above the controls, which show for a few
     seconds as a level starts, and the light meter (LightMeter.as) sits bottom left. The HUD lies
     over the level and takes none of its input. Styled by LamplightSheet.css. The screen stack's
     back (Escape, East) is off here: the game's own Pause action (Lamplight.as) takes its place.
     -->
<Screen blocks="false" back="none">
  <Panel class="hud">
    <Panel class="hud-top">
      <Panel class="hud-card">
        <Label id="hud-target" class="hud-target" text=""/>
        <Label id="hud-loot" class="hud-loot" text=""/>
      </Panel>
      <Label id="hud-note" class="hud-note" text="Checkpoint"/>
      <Panel class="hud-card"><Label id="hud-time" class="hud-time" text="0:00"/></Panel>
    </Panel>
    <Panel class="hud-foot">
      <Panel class="hud-row">
        <Panel id="hud-prompt-panel" class="hud-card hud-prompt-card">
          <Label id="hud-prompt" class="hud-prompt" text=""/>
          <ProgressBar id="hud-pick" class="hud-pick" value="0"/>
        </Panel>
      </Panel>
      <Panel class="hud-row">
        <Panel id="hud-controls" class="controls hud-controls">
          <Panel class="controls-row"><Label class="controls-action" text="Move"/><Prompt class="controls-key" action="Move" set="Gameplay"/></Panel>
          <Panel class="controls-row"><Label class="controls-action" text="Sneak: slow and silent"/><Prompt class="controls-key" action="Sneak" set="Gameplay"/></Panel>
          <Panel class="controls-row"><Label class="controls-action" text="Run: fast and loud"/><Prompt class="controls-key" action="Run" set="Gameplay"/></Panel>
          <Panel class="controls-row"><Label class="controls-action" text="Use: open, put out, hold to pick a lock"/><Prompt class="controls-key" action="Interact" set="Gameplay"/></Panel>
          <Panel class="controls-row"><Label class="controls-action" text="Throw a pebble"/><Prompt class="controls-key" action="Throw" set="Gameplay"/></Panel>
          <Panel class="controls-row"><Label class="controls-action" text="Turn the view"/><Prompt class="controls-key" action="TurnLeft" set="Gameplay"/><Label class="controls-or" text="/"/><Prompt class="controls-key" action="TurnRight" set="Gameplay"/></Panel>
          <Panel class="controls-row"><Label class="controls-action" text="Pause"/><Prompt class="controls-key" action="Pause" set="Gameplay"/></Panel>
        </Panel>
      </Panel>
      <Panel class="hud-meter-row">
        <Panel class="hud-card hud-meter">
          <Label id="hud-light-label" class="hud-light-label" text="Hidden"/>
          <ProgressBar id="hud-light" class="hud-light" value="0"/>
        </Panel>
      </Panel>
    </Panel>
  </Panel>
</Screen>
