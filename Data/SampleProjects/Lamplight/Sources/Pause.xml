<!-- The pause menu, over a level that holds still (Lamplight.as). Styled by LamplightSheet.css.
     The screen stack's back (Escape, East) is off here: the game's own Pause action (Lamplight.as)
     takes its place. -->
<Screen class="fades" nav-default="resume-btn" back="none">
  <Panel class="centre">
    <Panel class="card pause-card">
      <Label class="pause-title" text="Paused"/>
      <Button id="resume-btn" class="amber" text="Resume"/>
      <Button id="restart-btn" class="amber" text="Start the level over"/>
      <Button id="title-btn" class="amber" text="Leave to the title"/>
      <Panel class="controls pause-controls">
        <Panel class="controls-row"><Label class="controls-action" text="Move"/><Prompt class="controls-key" action="Move" set="Gameplay"/></Panel>
        <Panel class="controls-row"><Label class="controls-action" text="Sneak: slow and silent"/><Prompt class="controls-key" action="Sneak" set="Gameplay"/></Panel>
        <Panel class="controls-row"><Label class="controls-action" text="Run: fast and loud"/><Prompt class="controls-key" action="Run" set="Gameplay"/></Panel>
        <Panel class="controls-row"><Label class="controls-action" text="Use: open, put out, hold to pick a lock"/><Prompt class="controls-key" action="Interact" set="Gameplay"/></Panel>
        <Panel class="controls-row"><Label class="controls-action" text="Throw a pebble"/><Prompt class="controls-key" action="Throw" set="Gameplay"/></Panel>
        <Panel class="controls-row"><Label class="controls-action" text="Turn the view"/><Prompt class="controls-key" action="TurnLeft" set="Gameplay"/><Label class="controls-or" text="/"/><Prompt class="controls-key" action="TurnRight" set="Gameplay"/></Panel>
        <Panel class="controls-row"><Label class="controls-action" text="Pause"/><Prompt class="controls-key" action="Pause" set="Gameplay"/></Panel>
      </Panel>
    </Panel>
  </Panel>
</Screen>
