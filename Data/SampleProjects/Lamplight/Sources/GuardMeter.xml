<!-- Over a guard's head (a billboard, Guard.as): what he makes of the thief. The mark is "?"
     while he is suspicious and "!" once he has seen him; the bar is how much he has seen. Styled by
     LamplightSheet.css. -->
<Panel class="guard-meter">
  <Label id="mark" class="guard-mark" text="?"/>
  <ProgressBar id="meter" class="guard-bar" value="0"/>
</Panel>
