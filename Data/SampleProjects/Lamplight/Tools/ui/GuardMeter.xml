<!-- The billboard over a guard's head (Guard.as), showing what he makes of the thief. The mark is
     "?" while he is suspicious and "!" once he has seen the thief; the bar shows how much he has
     seen. Styled by LamplightSheet.css. -->
<Panel class="guard-meter">
  <Label id="mark" class="guard-mark" text="?"/>
  <ProgressBar id="meter" class="guard-bar" value="0"/>
</Panel>
