<screen mode="overlay">

  <!-- Over a guard's head (a billboard, Guard.as): what he makes of the thief. The mark is "?"
       while he is suspicious and "!" once he has seen him; the bar is how much he has seen. -->
  <Flex direction="vertical" align="center" spacing="4" width="120">
    <Label id="mark" text="?" font-size="34" style="text-color: #FFE07A;"/>
    <ProgressBar id="meter" value="0" width="90" height="10"/>
  </Flex>

</screen>
