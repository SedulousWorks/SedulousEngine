using System;

namespace Lamplight;

/// The assets the game's code names by id: its levels, screens and sounds, as the project's imports
/// and Tools/ made them (a re-import or a rewrite keeps an asset's id).
static class Assets
{
	// The five levels in order (Scenes/, written by Tools/level.py).
	public static readonly Guid Gardens = Id("5fa1899e-3821-bd48-8496-af9ac424f3af");
	public static readonly Guid StableYard = Id("9eb240a8-1932-5c41-ab85-32dce8316311");
	public static readonly Guid GroundFloor = Id("ea1b9d4f-e046-6a4d-9a9d-81f3009cdff1");
	public static readonly Guid Cellars = Id("14a2028d-8afd-f04f-a8ab-db225cd000ab");
	public static readonly Guid UpperFloor = Id("820e413e-b99e-8948-8662-503d1d009645");

	// The screens, on the engine GUI (Tools/ui, imported by Tools/importui.py), pushed by id.
	public const String TitleDoc = "{51ece022-887a-874e-b227-03a5188e5278}";
	public const String HudDoc = "{2cb0815a-3081-bf4f-a3ba-acf7a97ad20c}";
	public const String PauseDoc = "{966442e3-686e-ea4e-8f22-f1c583004ba8}";
	public const String ResultsDoc = "{34ceeb07-3b1d-f74d-a69a-6e41c0a55456}";

	// The sounds (Audio/, generated by Tools/sounds.py).
	/// Loot taken: the jingle of coins.
	public static readonly Guid CoinsSound = Id("c312e32d-4e79-5746-8038-7d9b96c51ec1");
	/// The level's target taken.
	public static readonly Guid TakenSound = Id("3f034bd0-3bc2-4e4f-9e19-4199d3186b9c");
	/// The upper floor's alarm bell.
	public static readonly Guid BellSound = Id("2f16dade-2d4b-bf4f-b20a-4560c5042528");

	// The footsteps: three takes on each surface (Audio/Step<Surface><take>).
	public static readonly Guid StepWood1 = Id("3ff62114-4c37-a34a-a08e-a54422e4578f");
	public static readonly Guid StepWood2 = Id("7b5cdf5d-a8ad-534d-864d-56cf19695220");
	public static readonly Guid StepWood3 = Id("ccfa4d3e-93e6-584d-b1b6-03c8dab96715");
	public static readonly Guid StepStone1 = Id("b2d4f470-f3d1-7045-ad5b-c76f0a3ae441");
	public static readonly Guid StepStone2 = Id("5c1710a6-3b79-bd4b-98d4-6471206d08eb");
	public static readonly Guid StepStone3 = Id("9da2e8fd-c7fa-7746-95e0-d0ad662363f1");
	public static readonly Guid StepGravel1 = Id("bfc76a6a-1cac-1e4a-bf16-34dbdd014b6b");
	public static readonly Guid StepGravel2 = Id("ae5f2a99-7f81-5f4a-a1bf-e496e463b54d");
	public static readonly Guid StepGravel3 = Id("148d6f01-56d5-db4f-9f8a-5fa7a40e237e");
	public static readonly Guid StepGrass1 = Id("5cadf355-fa69-2e4f-b752-8c727c346cc7");
	public static readonly Guid StepGrass2 = Id("1b42bda8-b7c2-8d4e-a6b3-c693e47477ff");
	public static readonly Guid StepGrass3 = Id("562f7260-ff9a-cd41-84bc-0f7024248c82");

	/// The step on `surface`, take `take` (1 to 3).
	public static Guid Step(Surface surface, int32 take)
	{
		switch (surface)
		{
		case .Stone: return (take == 1) ? StepStone1 : ((take == 2) ? StepStone2 : StepStone3);
		case .Gravel: return (take == 1) ? StepGravel1 : ((take == 2) ? StepGravel2 : StepGravel3);
		case .Grass: return (take == 1) ? StepGrass1 : ((take == 2) ? StepGrass2 : StepGrass3);
		default: return (take == 1) ? StepWood1 : ((take == 2) ? StepWood2 : StepWood3);
		}
	}

	private static Guid Id(StringView text) => Guid.Parse(text).Get();
}
