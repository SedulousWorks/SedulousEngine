<!-- The pause menu (Snowline.as), with the run holding still under it. Escape, Start or B resumes.
     Styled by SnowlineSheet.css. The screen stack's back (Escape, East) is off here: the game's own
     Pause action (Snowline.as) takes its place. -->
<Screen class="fades" nav-default="resume-btn" back="none">
  <Panel class="centre">
    <Panel class="card pause-card">
      <Label class="pause-title" text="Paused"/>
      <Button id="resume-btn" class="slate wide" text="Resume"/>
      <Button id="restart-btn" class="slate wide" text="Restart run"/>
      <Button id="courses-btn" class="slate wide" text="Courses"/>
      <Panel class="controls pause-controls">
        <Panel class="controls-row"><Label class="controls-action" text="Carve, and spin in the air"/><Prompt class="controls-key" action="Move" set="Gameplay"/></Panel>
        <Panel class="controls-row"><Label class="controls-action" text="Jump"/><Prompt class="controls-key" action="Jump" set="Gameplay"/></Panel>
        <Panel class="controls-row"><Label class="controls-action" text="Tuck"/><Prompt class="controls-key" action="Tuck" set="Gameplay"/></Panel>
        <Panel class="controls-row"><Label class="controls-action" text="Grab, in the air"/><Prompt class="controls-key" action="Grab" set="Gameplay"/></Panel>
        <Panel class="controls-row"><Label class="controls-action" text="Pause"/><Prompt class="controls-key" action="Pause" set="Gameplay"/></Panel>
      </Panel>
      <Label class="pause-hint" text="Escape, Start or B to ride on"/>
    </Panel>
  </Panel>
</Screen>
