<!-- The ending (Snowline.as shows it after a run that wins a better medal on Ridge, the last
     course): the best medal and time on each course, their total and the medals won. Jump goes back
     to the courses. Styled by SnowlineSheet.css. Back (Escape, East) is the game's own
     Pause action (Snowline.as), not the screen stack's. -->
<Screen class="fades" back="none">
  <Panel class="centre">
    <Panel class="card ending-card">
      <Label class="ending-title" text="The mountain is yours"/>
      <Label id="end-headline" class="ending-headline" text=""/>
      <Panel class="ending-row">
        <Panel class="ending-course"><Panel id="end-0-medal" class="medal"/><Label class="ending-name" text="Meadow"/></Panel>
        <Label id="end-0-best" class="ending-best" text=""/>
      </Panel>
      <Panel class="ending-row">
        <Panel class="ending-course"><Panel id="end-1-medal" class="medal"/><Label class="ending-name" text="Forest"/></Panel>
        <Label id="end-1-best" class="ending-best" text=""/>
      </Panel>
      <Panel class="ending-row">
        <Panel class="ending-course"><Panel id="end-2-medal" class="medal"/><Label class="ending-name" text="Ridge"/></Panel>
        <Label id="end-2-best" class="ending-best" text=""/>
      </Panel>
      <Panel class="rule" width="420"/>
      <Panel class="ending-row"><Label class="ending-label" text="All three"/><Label id="end-total" class="ending-value" text=""/></Panel>
      <Panel class="ending-row"><Label class="ending-label" text="Medals"/><Label id="end-medals" class="ending-value" text=""/></Panel>
      <Label id="end-closing" class="ending-closing" text="Thanks for riding."/>
      <Label class="ending-hint" text="Jump for the courses"/>
    </Panel>
  </Panel>
</Screen>
