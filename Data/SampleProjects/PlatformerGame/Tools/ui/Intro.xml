<!-- A level's intro (PlatformerGame.as): its number and name on a cloud that drops in from above
     once the fade clears, until Jump starts play. Over the frozen level, taking none of its input.
     Styled by SkyHopperSheet.css. Back (Escape, East) is the game's own Pause action. -->
<Screen blocks="false" back="none">
  <Panel class="centre">
    <Panel id="intro-card" class="cloud intro-card">
      <Label id="intro-number" class="note intro-number" text="Level 1"/>
      <Label id="intro-name" class="headline lilita intro-name" text="Grassy Hills"/>
      <Label id="intro-prompt" class="body intro-prompt" text="Press Space or A to start"/>
    </Panel>
  </Panel>
</Screen>
