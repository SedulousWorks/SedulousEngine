<!-- The pause menu over a level at a standstill (PlatformerGame.as). Styled by SkyHopperSheet.css.
     Back (Escape, East) is the game's own Pause action, not the screen stack's. -->
<Screen class="fades" nav-default="resume-btn" back="none">
  <Panel class="veil heavy">
    <Panel class="cloud card">
      <Label id="pause-title" class="headline lilita card-title" text="Paused"/>
      <Panel class="menu pause-menu">
        <Button id="resume-btn" class="primary" text="Resume"/>
        <Button id="restart-btn" text="Restart Level"/>
        <Button id="title-btn" text="Quit to Title"/>
      </Panel>
    </Panel>
  </Panel>
</Screen>
