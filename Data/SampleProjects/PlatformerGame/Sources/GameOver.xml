<!-- The game over (PlatformerGame.as): where the run got to, its score and the best run, then
     try again or the title. Styled by SkyHopperSheet.css. Back (Escape, East) is the game's own
     Pause action, not the screen stack's. -->
<Screen class="pops" nav-default="gameover-retry-btn" back="none">
  <Panel class="veil heavy">
    <Panel class="cloud card end-card">
      <Label id="gameover-title" class="headline lilita end-title" text="Game Over"/>
      <Label id="gameover-reached" class="note end-line" text=""/>
      <Panel class="end-score-row">
        <Label class="tally-name end-score-name" text="Score"/>
        <Label id="gameover-score" class="tally-total lilita end-score" text="0"/>
      </Panel>
      <Label id="gameover-best" class="best lilita end-best" text=""/>
      <Panel class="menu end-menu">
        <Button id="gameover-retry-btn" class="primary big" text="Try Again"/>
        <Button id="gameover-title-btn" text="Back to Title"/>
      </Panel>
    </Panel>
  </Panel>
</Screen>
