<screen mode="overlay" transition="fade">

  <Flex direction="vertical" justify="center" align="center" padding="32">

    <Panel padding="28"
           style="background: rounded-rect(rgba(12, 16, 26, 0.82), radius=14, border-width=2, border=rgb(255, 226, 120));">
      <Flex direction="vertical" align="center" spacing="6">
        <Label id="intro-number" text="Level 1" font-size="22" class="label-dim"/>
        <Label id="intro-name" font-family="Lilita One" text="Grassy Hills" font-size="46" style="text-color: rgb(255, 226, 120);"/>
        <Spacer spacer-height="14"/>
        <Label id="intro-prompt" text="Press Space or A to start" font-size="18" class="label"/>
      </Flex>
    </Panel>

  </Flex>

</screen>
