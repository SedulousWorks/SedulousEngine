<!-- A failed block (PaperKidGame.as): why, the lives left, and try again or the title. Styled by
     PaperKidSheet.css. Back (Escape, East) is the game's own Pause
     action (PaperKidGame.as), not the screen stack's. -->
<Screen class="fades" nav-default="retry-btn" back="none">
  <Panel class="dim">
    <Panel class="card card-bad result-card">
      <Label id="failed-title" class="headline-bad slab" text="Route failed"/>
      <Label id="failed-reason" class="body summary" text=""/>
      <Label id="failed-lives" class="note lives" text=""/>
      <Panel class="menu result-menu">
        <Button id="retry-btn" class="primary" text="Try again"/>
        <Button id="menu-btn" text="Main menu"/>
      </Panel>
    </Panel>
  </Panel>
</Screen>
