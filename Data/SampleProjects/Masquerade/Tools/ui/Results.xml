<!-- The round's end (Masquerade.as): who won, every hunter's points, and what next. Styled by
     MasqueradeSheet.css. Back (Escape, East) is the game's own Pause action (Masquerade.as), not
     the screen stack's. -->
<Screen class="fades" nav-default="again-btn" back="none">
  <Panel class="centre">
    <Panel class="card results-card">
      <Label id="res-title" class="results-title" text=""/>
      <Label id="res-you" class="results-you" text=""/>
      <Label id="res-0" class="results-line" text=""/>
      <Label id="res-1" class="results-line" text=""/>
      <Label id="res-2" class="results-line" text=""/>
      <Label id="res-3" class="results-line" text=""/>
      <Label id="res-best" class="results-best" text=""/>
      <Button id="again-btn" class="gold results" text="Another round"/>
      <Button id="title-btn" class="gold results" text="Leave to the title"/>
    </Panel>
  </Panel>
</Screen>
