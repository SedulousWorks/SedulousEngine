<!-- The round's end (Masquerade.as): who won, then every hunter ranked by points (you lit), your best
     round on this map, and what next. The ball dims and blurs behind it. Styled by
     MasqueradeSheet.css. Back (Escape, East) is the game's own Pause action (Masquerade.as), not
     the screen stack's. -->
<Screen class="dimmed" nav-default="again-btn" back="none">
  <Panel class="centre">
    <Panel class="card results-card">
      <Label id="res-title" class="results-title" text=""/>
      <Label id="res-you" class="results-you" text=""/>
      <Panel class="rank-table">
        <Panel id="rank-0" class="rank-row"><Label id="rank-place-0" class="rank-place" text=""/><Label id="rank-name-0" class="rank-name" text=""/><Label id="rank-points-0" class="rank-points" text=""/></Panel>
        <Panel id="rank-1" class="rank-row"><Label id="rank-place-1" class="rank-place" text=""/><Label id="rank-name-1" class="rank-name" text=""/><Label id="rank-points-1" class="rank-points" text=""/></Panel>
        <Panel id="rank-2" class="rank-row"><Label id="rank-place-2" class="rank-place" text=""/><Label id="rank-name-2" class="rank-name" text=""/><Label id="rank-points-2" class="rank-points" text=""/></Panel>
        <Panel id="rank-3" class="rank-row"><Label id="rank-place-3" class="rank-place" text=""/><Label id="rank-name-3" class="rank-name" text=""/><Label id="rank-points-3" class="rank-points" text=""/></Panel>
      </Panel>
      <Label id="res-best" class="results-best" text=""/>
      <Panel class="page-buttons">
        <Button id="title-btn" class="gold page" text="Leave"/>
        <Button id="again-btn" class="gold page primary" text="Another round"/>
      </Panel>
    </Panel>
  </Panel>
</Screen>
