<!-- The pause menu over a round that holds still (Masquerade.as), the ball dimmed and blurred behind it. Styled by MasqueradeSheet.css. Back (Escape, East) is the game's own
     Pause action (Masquerade.as), not the screen stack's. -->
<Screen class="dimmed" nav-default="resume-btn" back="none">
  <Panel class="centre">
    <Panel class="card pause-card">
      <Label class="pause-title" text="Paused"/>
      <Button id="resume-btn" class="gold wide" text="Resume"/>
      <Button id="pause-controls-btn" class="gold wide" text="Controls"/>
      <Button id="restart-btn" class="gold wide" text="Start the round over"/>
      <Button id="title-btn" class="gold wide" text="Leave to the title"/>
    </Panel>
  </Panel>
</Screen>
