using System;

namespace Masquerade;

/// The assets the game's code names by id: its maps, screens, portraits, sounds and music, as the
/// project's imports and Tools/ made them (a re-import or a rewrite keeps an asset's id).
static class Assets
{
	// The three maps (Scenes/, written by Tools/maps.py).
	public static readonly Guid Palace = Id("9f75a606-4c88-6646-8c10-0f79b1ec6760");
	public static readonly Guid Canal = Id("1ee1e11f-2825-0d4d-8e7a-71f2e7f7b797");
	public static readonly Guid Gardens = Id("4b1f85c8-28ad-ed4a-bb1c-83fbab825359");

	// The screens, on the engine GUI (Tools/ui, imported by Tools/importui.py), pushed by id.
	public const String TitleDoc = "{476521d2-c645-7b45-9047-d276ed406b3c}";
	public const String MapsDoc = "{625415a9-2561-2245-8b31-9312518bb7de}";
	public const String JoinDoc = "{bb3b6bce-e2d1-214d-b6af-da38adc2842b}";
	public const String ControlsDoc = "{5b9f9c58-643b-7c44-91b1-002b1aa7dbb3}";
	public const String HudDoc = "{17588a14-e4fa-d84b-aa8d-e694112dcfec}";
	public const String PauseDoc = "{7c0427df-ebc1-5b44-b3ca-59e7665a9d7d}";
	public const String ResultsDoc = "{d57cac1f-5cf9-af40-99a7-8d600b9d0424}";

	// Each costume's portrait (Tools/portraits.py), as the HUD's Image takes a texture: "{id}".
	public const String PortraitGownRose = "{945248b7-f0f2-ce41-99cf-1747ad8b2660}";
	public const String PortraitGownTeal = "{c05268f7-d4d7-b445-a07f-be5ed42cd7fa}";
	public const String PortraitGownGold = "{20815dca-35ab-a34d-b010-f24c7e118938}";
	public const String PortraitCoatBlack = "{0ce689e3-b625-de43-8b2b-f32369887966}";
	public const String PortraitCoatPlum = "{87083e18-ffd5-3b4d-bcca-088c15c5be36}";
	public const String PortraitCoatIvory = "{e606123c-613d-e145-8c54-002ac4650e8e}";

	/// The portrait of `costume`, in the costumes' order (rose, teal and gold gowns, black, plum
	/// and ivory coats); empty for one outside them.
	public static StringView Portrait(int32 costume)
	{
		switch (costume)
		{
		case 0: return PortraitGownRose;
		case 1: return PortraitGownTeal;
		case 2: return PortraitGownGold;
		case 3: return PortraitCoatBlack;
		case 4: return PortraitCoatPlum;
		case 5: return PortraitCoatIvory;
		default: return "";
		}
	}

	// The sounds (Audio/, generated by Tools/sounds.py): what the round says to the player, and
	// the buttons.
	public static readonly Guid TagSound = Id("2dfbc8dd-48c8-6b43-af44-b28b868fb846");
	public static readonly Guid MissSound = Id("2fb079ad-e813-2347-b18b-340c653452d7");
	public static readonly Guid FlareSound = Id("d71ba43c-28b2-9c4f-992b-c9b6d6a33789");
	public static readonly Guid ChimeSound = Id("e3f71e41-2fd3-2b4b-96a2-4c556549fadd");
	public static readonly Guid Fanfare = Id("2b90c687-05c3-7243-8fbe-b2fd4ec41c82");
	public static readonly Guid Click = Id("d778e0c8-c359-f042-b872-894ef2584857");

	// The orchestra's three pieces (Audio/, generated by Tools/sounds.py), one per cue.
	public static readonly Guid Waltz = Id("2c804143-d88d-d746-9673-b9f637c7eb6a");
	public static readonly Guid Air = Id("6440802e-0569-0848-bdc0-b92d789247af");
	public static readonly Guid DanceMusic = Id("15d760b2-38be-4d42-bd04-23b49ae59ba7");

	private static Guid Id(StringView text) => Guid.Parse(text).Get();
}
