<!-- GENERATED by Tools/ui.py from Tools/lessons.py. The lesson list in the top left, as tall as
     its rows (a short window still fits it): a row per lesson (Gallery.as glides the camera to it).
     What the picked lesson teaches shows in a caption at the foot of the free view, which Gallery.as
     hides until a row is clicked. H hides both. Styled by GallerySheet.css, the project's GUI sheet.
     The screen takes none of the hall's input (its empty space no pointer: a drag there looks
     around), and back (Escape, East) leaves the list where it is. -->
<Screen blocks="false" back="none">
<Panel class="gallery">
  <Panel id="gallery-panel" class="gallery-card gallery-list">
    <Label class="gallery-heading" text="Shader Gallery"/>
    <Label class="gallery-lead" text="A lesson per shader: pick one"/>
    <Panel class="gallery-lessons">
      <Button id="lesson-1" class="lesson" text="1. Unlit Colour   (unlit surface)"/>
      <Button id="lesson-2" class="lesson" text="2. Textured   (lit surface)"/>
      <Button id="lesson-3" class="lesson" text="3. Lava   (lit surface)"/>
      <Button id="lesson-4" class="lesson" text="4. Hologram   (unlit surface)"/>
      <Button id="lesson-5" class="lesson" text="5. Triplanar Rock   (lit surface)"/>
      <Button id="lesson-6" class="lesson" text="6. Dissolve   (lit surface)"/>
      <Button id="lesson-7" class="lesson" text="7. Waves   (lit surface)"/>
      <Button id="lesson-8" class="lesson" text="8. Wind   (lit surface)"/>
      <Button id="lesson-9" class="lesson" text="9. Built-in PBR   (lit surface)"/>
      <Button id="lesson-10" class="lesson" text="10. Toon   (low-level)"/>
      <Button id="lesson-11" class="lesson" text="11. Custom Lighting   (low-level)"/>
    </Panel>
    <Label class="gallery-hint" text="WASD fly, Q/E down and up, Shift faster"/>
