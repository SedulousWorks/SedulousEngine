<!--
  A sample's download, in three stages in one window: where it goes (the location, whether it gets
  a folder of its name there, and New Project's check line; Download waits while the line is red);
  its progress, with Cancel; and how it ended: done, with Open for the new project, or why not, with
  Try again. Code shows one stage at a time.
-->
<Panel class="dialog-body new-project">
    <Panel id="download-sample-choose" class="new-project">
        <Panel class="form">
            <Label class="form-label" text="Location"/>
            <Panel class="form-field">
                <Panel class="new-project-folder"><TextField id="download-sample-parent" placeholder="The folder it goes in"/><Button id="download-sample-browse" text="Browse..."/></Panel>
                <CheckBox id="download-sample-own-folder"/>
            </Panel>
        </Panel>
        <Panel id="download-sample-check" class="new-project-check">
            <Image id="download-sample-check-icon" class="message-icon"/>
            <Label id="download-sample-where" class="new-project-check-text"/>
        </Panel>
    </Panel>
    <Panel id="download-sample-progress" class="download-sample-progress">
        <ProgressBar id="download-sample-bar"/>
        <Label id="download-sample-stage" class="manager-meta"/>
    </Panel>
    <Panel id="download-sample-result" class="new-project-check">
        <Image id="download-sample-result-icon" class="message-icon"/>
        <Label id="download-sample-result-text" class="new-project-check-text"/>
    </Panel>
    <Panel class="dialog-buttons">
        <Label id="download-sample-size" class="manager-meta"/>
        <Spacer/>
        <Button id="download-sample-cancel" text="Cancel"/>
        <Button id="download-sample-close" text="Close"/>
        <Button id="download-sample-retry" text="Try again"/>
        <Button id="download-sample-go" class="primary" text="Download" enabled="false"/>
        <Button id="download-sample-open" class="primary" text="Open"/>
    </Panel>
</Panel>
