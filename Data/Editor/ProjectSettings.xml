<!--
  Project Settings (Documentation/Specs/editor-gui.md, 5.2, layer 6; ruling 20): the project's
  manifest on the property grid, a section per category the settings name. Save keeps it,
  Cancel (or closing) leaves the manifest as it was. Code fills the grid.
-->
<Panel class="dialog-body project-settings">
    <PropertyGrid id="settings-grid" class="settings-grid"/>
    <Panel class="dialog-buttons"><Spacer/><Button id="settings-cancel" text="Cancel"/><Button id="settings-save" class="primary" text="Save"/></Panel>
</Panel>
