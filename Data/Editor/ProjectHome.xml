<!--
  The Project panel with a project open, in two columns. On the left the project: its picture,
  name, location, engine version and the settings that sum it up, then Show in Folder and Project
  Settings. On the right its scenes, each a card that opens it, or, with none yet, a note with New
  Scene. Code fills each part by id from the project and its settings' reflection.
-->
<ScrollView class="home-scroll">
    <Panel class="home">
        <Panel class="home-side">
            <Panel id="home-picture" class="home-picture-slot"/>
            <Label id="home-name" class="home-name"/>
            <Panel id="home-summary" class="home-summary"/>
            <Panel class="home-buttons">
                <Button id="home-show-folder" class="with-icon" icon="Editor/Icons/folder-open.svg" text="Show in Folder"/>
                <Button id="home-settings" class="with-icon" icon="Editor/Icons/settings.svg" text="Project Settings..."/>
            </Panel>
        </Panel>
        <Panel class="home-divider"/>
        <Panel class="home-main">
            <Panel class="home-section-head">
                <Label class="home-section" text="SCENES"/>
                <Label id="home-scene-count" class="home-count"/>
                <Spacer/>
                <Button id="home-new-scene" class="ghost with-icon" icon="Editor/Icons/plus.svg" text="New Scene"/>
            </Panel>
            <Panel id="home-scenes" class="home-scenes"/>
            <Panel id="home-no-scenes" class="home-no-scenes">
                <Image class="home-no-scenes-icon" src="Editor/Icons/Types/SceneDocument.svg"/>
                <Label class="home-no-scenes-title" text="No scenes yet"/>
                <Label class="home-no-scenes-text" text="A scene holds what the game shows: a sun, a floor, a camera. The first one you make becomes the default scene, where the game starts."/>
                <Button id="home-first-scene" class="primary with-icon" icon="Editor/Icons/plus.svg" text="New Scene"/>
            </Panel>
        </Panel>
    </Panel>
</ScrollView>
