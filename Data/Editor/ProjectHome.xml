<!--
  The Project panel with a project open (Documentation/Specs/editor-gui.md, 5.1, layer 13): the
  project's picture, name, engine and folder; Start (open the default scene, the Game menu's
  actions, every scene); Project (every setting by category, an asset a link that opens it, then
  the Project menu's actions). Code fills each part by id from the project, its settings'
  reflection and the action registry.
-->
<ScrollView class="home-scroll">
    <Panel class="home">
        <Panel class="home-header">
            <Panel id="home-picture" class="home-picture-slot"/>
            <Panel class="home-identity">
                <Label id="home-name" class="home-name"/>
                <Label id="home-engine" class="home-meta"/>
                <Label id="home-folder" class="home-meta home-folder"/>
            </Panel>
        </Panel>
        <Panel class="home-columns">
            <Panel class="home-column home-start">
                <Label class="home-heading" text="Start"/>
                <Button id="home-open-default" class="primary home-open"/>
                <Panel id="home-game-actions" class="home-actions"/>
                <Label id="home-scenes-heading" class="home-heading"/>
                <Panel id="home-scenes" class="home-links"/>
            </Panel>
            <Panel class="home-column home-project">
                <Label class="home-heading" text="Project"/>
                <Panel id="home-settings" class="home-settings"/>
                <Panel id="home-project-actions" class="home-actions"/>
            </Panel>
        </Panel>
    </Panel>
</ScrollView>
