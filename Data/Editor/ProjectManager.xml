<!--
  The project manager: the window's whole screen while no project is open. A header holds the
  Projects and Samples tabs. On Projects a toolbar (New Project, Open Folder, a search, the sort,
  list or grid) sits over the projects, with the missing ones in a section of their own; on Samples
  are the sample games of an engine's release (the engine picked beside them, where the host offers
  engines), each with its Download... button; on Engines (with
  an engine manager alone) the engines listed and the ones the releases offer; on Toolchain what a
  project's build needs besides the engine; and a footer shows the status and the keys. With no
  projects at all, a welcome takes their place. Code fills the lists, the counts and the status
  line by id.
-->
<Panel class="manager">
    <Panel class="manager-header">
        <Image id="manager-logo" class="manager-logo" src="Branding/sedulous-logo.svg"/>
        <Panel class="manager-tabs">
            <Button id="manager-tab-projects" class="manager-tab" name="manager-tab" toggle="true" text="Projects"/>
            <Button id="manager-tab-samples" class="manager-tab" name="manager-tab" toggle="true" text="Samples"/>
            <Button id="manager-tab-engines" class="manager-tab" name="manager-tab" toggle="true" text="Engines"/>
            <Button id="manager-tab-toolchain" class="manager-tab" name="manager-tab" toggle="true" text="Toolchain"/>
        </Panel>
        <Spacer/>
        <Label id="manager-engine" class="manager-meta"/>
    </Panel>

    <Panel id="manager-projects-page" class="manager-page">
        <Panel class="manager-toolbar">
            <Button id="manager-new" class="primary with-icon" icon="Editor/Icons/plus.svg" text="New Project..."/>
            <Button id="manager-open" class="with-icon" icon="Editor/Icons/folder-open.svg" text="Open Folder..."/>
            <Spacer/>
            <Panel class="search manager-search">
                <Image class="search-icon" src="Editor/Icons/search.svg"/>
                <TextField id="manager-search" class="search-field" placeholder="Search by name or folder"/>
                <Label class="manager-key" text="Ctrl+F"/>
            </Panel>
            <Label class="manager-meta" text="Sort"/>
            <ComboBox id="manager-sort" class="manager-sort" items="Last opened|Name" selected="0"/>
            <Panel class="segmented">
                <Button id="manager-list" class="segment icon-segment" name="manager-view" toggle="true" icon="Editor/Icons/list.svg" tooltip="List"/>
                <Button id="manager-grid" class="segment icon-segment" name="manager-view" toggle="true" icon="Editor/Icons/tiles.svg" tooltip="Grid"/>
            </Panel>
        </Panel>
        <Panel id="manager-scroll" class="manager-scroll">
            <Panel class="manager-section-head">
                <Label class="manager-section" text="PROJECTS"/>
                <Label id="manager-count" class="manager-count"/>
            </Panel>
            <Label id="manager-no-match" class="manager-no-match"/>
            <Panel id="manager-projects" class="manager-projects"/>
            <Panel id="manager-missing" class="manager-missing">
                <Panel class="manager-section-head">
                    <Label class="manager-section" text="MISSING"/>
                    <Label id="manager-missing-count" class="manager-count"/>
                    <Spacer/>
                    <Button id="manager-remove-missing" class="ghost manager-small" text="Remove missing from list"/>
                </Panel>
                <Panel id="manager-missing-list" class="manager-missing-list"/>
            </Panel>
        </Panel>
    </Panel>

    <Panel id="manager-samples-page" class="manager-page">
        <Panel class="manager-toolbar">
            <Label id="manager-samples-intro" class="manager-meta"/>
            <Spacer/>
            <Panel id="manager-samples-engine-field" class="manager-samples-engine-field">
                <Label class="manager-meta" text="Engine"/>
                <ComboBox id="manager-samples-engine" class="manager-samples-engine" tooltip="The engine whose release's samples are listed: a sample you download opens with it"/>
            </Panel>
        </Panel>
        <Panel id="manager-samples-scroll" class="manager-scroll">
            <Panel id="manager-samples" class="manager-samples"/>
        </Panel>
        <Panel id="manager-samples-state" class="state-box manager-samples-state">
            <Image id="manager-samples-state-icon" class="state-icon" src="Editor/Icons/world.svg"/>
            <Label id="manager-samples-state-title" class="state-title"/>
            <Label id="manager-samples-state-text" class="state-text"/>
            <Button id="manager-samples-retry" text="Retry"/>
        </Panel>
    </Panel>

    <Panel id="manager-engines-page" class="manager-page">
        <Panel class="manager-toolbar">
            <Button id="manager-engines-add" class="with-icon" icon="Editor/Icons/folder-open.svg" text="Add Folder..."/>
            <Button id="manager-engines-refresh" text="Check for Engines"/>
            <Spacer/>
            <Label class="manager-meta" text="Each project opens with an engine of its version; its menu picks another."/>
        </Panel>
        <Panel class="manager-scroll">
            <Panel class="manager-section-head">
                <Label class="manager-section" text="INSTALLED"/>
                <Label id="manager-engines-count" class="manager-count"/>
            </Panel>
            <Label id="manager-engines-none" class="manager-no-match" text="No engine is listed: install one below, or add an engine's folder."/>
            <Panel id="manager-engines-installed" class="manager-engines"/>
            <Panel class="manager-section-head manager-engines-available-head">
                <Label class="manager-section" text="AVAILABLE"/>
                <Label id="manager-engines-available-state" class="manager-count"/>
            </Panel>
            <Panel id="manager-engines-available" class="manager-engines"/>
        </Panel>
    </Panel>

    <Panel id="manager-toolchain-page" class="manager-page">
        <Panel class="manager-toolbar">
            <Label class="manager-meta" text="For engine"/>
            <ComboBox id="manager-toolchain-engine" class="manager-toolchain-engine" tooltip="The engine whose projects are built"/>
            <Button id="manager-toolchain-recheck" text="Check Again"/>
            <Spacer/>
            <Button id="manager-toolchain-install" class="primary" text="Install Toolchain"/>
        </Panel>
        <Panel class="manager-scroll">
            <Label id="manager-toolchain-none" class="manager-no-match" text="No engine is listed to build with: list one on the Engines tab."/>
            <Label id="manager-toolchain-pin" class="manager-meta"/>
            <Panel id="manager-toolchain-progress" class="manager-toolchain-progress">
                <ProgressBar id="manager-toolchain-bar"/>
                <Panel class="manager-sample-stage">
                    <Label id="manager-toolchain-stage"/>
                    <Button id="manager-toolchain-cancel" class="ghost" text="Cancel"/>
                </Panel>
            </Panel>
            <Panel id="manager-toolchain-lines" class="manager-toolchain-lines"/>
            <Panel class="manager-section-head manager-toolchain-emscripten-head">
                <Label class="manager-section" text="EMSCRIPTEN"/>
            </Panel>
            <Label class="manager-toolchain-detail" text="Only a web export needs it. Name the emsdk folder it was installed into, and the installed toolchain is told where it is."/>
            <Panel class="manager-toolchain-emscripten">
                <TextField id="manager-toolchain-emsdk" placeholder="The emsdk folder"/>
                <Button id="manager-toolchain-emsdk-browse" text="Browse..."/>
                <Button id="manager-toolchain-emsdk-set" class="primary" text="Set"/>
            </Panel>
        </Panel>
    </Panel>

    <Panel id="manager-welcome" class="manager-welcome">
        <Image class="manager-welcome-logo" src="Branding/sedulous-logo.svg"/>
        <Panel class="manager-welcome-text">
            <Label class="manager-welcome-title" text="Welcome"/>
            <Label class="manager-meta" text="Make a project, or open one you already have. Projects you open are listed here."/>
        </Panel>
        <Panel class="manager-welcome-cards">
            <Button id="manager-welcome-new" class="manager-card">
                <Panel class="manager-card-icon primary"><Image src="Editor/Icons/plus.svg"/></Panel>
                <Label class="manager-card-title" text="New Project"/>
                <Label class="manager-card-text" text="Name it and choose the folder it goes in. It opens as soon as it is made."/>
                <Label class="manager-key" text="Ctrl+N"/>
            </Button>
            <Button id="manager-welcome-open" class="manager-card">
                <Panel class="manager-card-icon"><Image src="Editor/Icons/folder-open.svg"/></Panel>
                <Label class="manager-card-title" text="Open Folder"/>
                <Label class="manager-card-text" text="Pick a project's folder, the one holding its Project.xml. You can also drop the folder on this window."/>
                <Label class="manager-key" text="Ctrl+O"/>
            </Button>
        </Panel>
    </Panel>

    <Panel class="manager-footer">
        <Label id="manager-status" class="manager-status"/>
        <Spacer/>
        <Panel id="manager-keys" class="manager-keys">
            <Label class="manager-key" text="Up Down"/><Label class="manager-meta" text="move"/>
            <Label class="manager-key" text="Enter"/><Label class="manager-meta" text="open"/>
            <Label class="manager-key" text="Del"/><Label class="manager-meta" text="remove from list"/>
            <Label class="manager-key" text="Ctrl+N"/><Label class="manager-meta" text="new"/>
            <Label class="manager-key" text="Ctrl+O"/><Label class="manager-meta" text="open folder"/>
        </Panel>
    </Panel>
</Panel>
