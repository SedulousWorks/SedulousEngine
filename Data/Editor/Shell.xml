<!--
  The editor's frame: the menu bar (its menus made from the actions), the dock (pages and the shared
  panels) and the status bar. Code fills each by id.
-->
<Panel id="frame" class="frame">
    <MenuBar id="menubar"/>
    <Panel id="frame-dock" class="frame-dock"/>
    <StatusBar id="statusbar">
        <StatusItem id="status-message-item" title="Message"><Label id="status-message" class="message"/></StatusItem>
        <StatusItem id="status-job" zone="end" title="Jobs">
            <Panel class="job"><Label id="status-job-name" class="job-name"/><ProgressBar id="status-job-progress" class="job-progress"/><Label id="status-job-count" class="job-count"/></Panel>
        </StatusItem>
        <StatusItem id="status-agent" zone="end" title="MCP">
            <Panel class="status-mcp">
                <Label id="status-agent-call" class="status-mcp-call mono"/>
                <Panel id="status-agent-dot" class="status-mcp-dot"/>
                <Button id="status-agent-text" class="status-mcp-button"/>
            </Panel>
        </StatusItem>
    </StatusBar>
</Panel>
