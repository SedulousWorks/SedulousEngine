<!--
  The script page: the kit's bar (Save, Undo, Redo, Discard Changes, Cook and Rebuild this asset,
  each an action over the page; then the page's own, which opens and closes the API browser; and the
  asset's kind at the end) over the code and its problems, one above the other, beside the API
  browser (its search over the language's bound API as a tree) when it is open. The code is
  coloured by the script's language and checked a moment after each edit; its gutter takes
  breakpoints, shared with the Game tabs. An asset that did not read says so in place of the code.
-->
<Panel class="page code-page script-page">
    <ToolBar id="page-bar" class="page-toolbar">
        <ToolButton id="page-save" icon="Editor/Icons/save.svg"/>
        <ToolButton id="page-undo" icon="Editor/Icons/undo.svg"/>
        <ToolButton id="page-redo" icon="Editor/Icons/redo.svg"/>
        <ToolButton id="page-discard" icon="Editor/Icons/revert.svg"/>
        <Separator/>
        <ToolButton id="page-cook" icon="Editor/Icons/cook.svg"/>
        <ToolButton id="page-rebuild" icon="Editor/Icons/rebuild.svg"/>
        <Separator id="page-own"/>
        <ToolButton id="script-api" toggle="true" icon="Editor/Icons/list.svg" text="API" shows-text="true" tooltip="What the script may call: the API the runtime binds for its language"/>
        <Spacer/>
        <Label id="page-kind" class="badge page-kind"/>
    </ToolBar>
    <Panel id="page-state" class="state-box failed page-state">
        <Image class="state-icon" src="Editor/Icons/warning.svg"/>
        <Label class="state-title" text="This asset did not read"/>
        <Label class="state-text" text="Its source could not be read; the Console says why. It is not saved over while it shows this."/>
    </Panel>
    <Splitter id="script-body" class="page-body" axis="horizontal" weights="0.72 0.28">
        <Splitter class="code-pane" axis="vertical" weights="0.8 0.2">
            <CodeEditor id="page-code" class="page-code"/>
            <Panel id="page-problems" class="panel page-problems"/>
        </Splitter>
        <Panel id="script-api-pane" class="panel page-pane api-pane">
            <Panel class="search-row">
                <Panel class="search">
                    <Image class="search-icon" src="Editor/Icons/search.svg"/>
                    <TextField id="script-api-search" class="search-field" placeholder="Find a type or a member"/>
                </Panel>
            </Panel>
            <TreeView id="script-api-tree" class="panel-body tree api-tree"/>
        </Panel>
    </Splitter>
</Panel>
