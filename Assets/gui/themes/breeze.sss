/* Breeze Dark theme for Sedulous.GUI
 * Inspired by KDE Breeze Dark color scheme.
 * Palette variables are pre-set by the loader.
 */

@palette breeze {
	primary:        #3daee9;
	primary-accent: #3daee9;
	background:     #232629;
	surface:        #31363b;
	surface-bright: #30353a;
	border:         #6b6f73;
	text:           #eff0f1;
	text-dim:       #898b8d;
	error:          #ff4040;
	success:        #40ff40;
	warning:        #ffff40;
}

/* === Global defaults === */

View {
	text-color: $text;
	font-size: 14;
}

/* === Button === */

ButtonBase {
	background: state-list(
		normal=rounded-rect(#3b4046, radius=2, border=#6b6f73, border-width=1),
		hover=rounded-rect(#3b4046, radius=2, border=#3daee9, border-width=1),
		pressed=rounded-rect(#3daee9, radius=2, border=#3daee9, border-width=1),
		focused=rounded-rect(#3b4046, radius=2, border=#3daee9, border-width=1),
		disabled=rounded-rect(#2e3338, radius=2, border=#43474c, border-width=1)
	);
	text-color: $text;
	padding: 5 10;
	corner-radius: 2;
}

ButtonBase:disabled {
	text-color: #727679;
}

/* === Panel === */

.panel {
	background: rounded-rect($surface, radius=2, border=$border, border-width=1);
}

/* === Label === */

.label {
	text-color: $text;
}

.label-dim {
	text-color: $text-dim;
}

/* === EditText === */

EditText {
	background: rounded-rect($background, radius=2, border=$border, border-width=1);
	text-color: $text;
	placeholder-color: $text-dim;
	font-size: 14;
	padding: 5 6;
	cursor-color: $primary;
	selection-color: rgba(61, 174, 233, 0.4);
	corner-radius: 2;
}

/* === NumericField === */

NumericField {
	background: rounded-rect($background, radius=2, border=$border, border-width=1);
	text-color: $text;
	placeholder-color: $text-dim;
	font-size: 14;
	padding: 5 6;
	cursor-color: $primary;
	selection-color: rgba(61, 174, 233, 0.4);
	corner-radius: 2;
}
NumericField::spin-up {
	background: state-rounded(#3a3f44, radius=2);
}
NumericField::spin-down {
	background: state-rounded(#3a3f44, radius=2);
}

/* === CheckBox === */

CheckBox {
	spacing: 6;
}
CheckBox::box {
	background: rounded-rect($background, radius=2, border=$border, border-width=1);
	width: 18;
}
CheckBox::box:checked {
	background: rounded-rect($primary, radius=2, border=$primary, border-width=1);
}
CheckBox::checkmark {
	background: svg(checkmark);
}

/* === RadioButton === */

RadioButton::box {
	background: rounded-rect($background, radius=9, border=$border, border-width=1);
}
RadioButton::box:checked {
	background: rounded-rect($primary, radius=9, border=$primary, border-width=1);
}
RadioButton::mark {
	background: svg(radio-mark-round);
}

/* === Slider === */

Slider::track {
	background: rounded-rect(#676a6e, radius=2);
	height: 4;
}
Slider::fill {
	background: rounded-rect($primary, radius=2);
}
Slider::thumb {
	background: rounded-rect($surface, radius=8, border=#787b80, border-width=1);
	width: 16;
}

/* === ProgressBar === */

ProgressBar::track {
	background: rounded-rect(#676a6e, radius=2);
}
ProgressBar::fill {
	background: rounded-rect($primary, radius=2);
}

/* === ToggleSwitch === */

ToggleSwitch::track {
	background: rounded-rect($surface, radius=12, border=$border, border-width=1);
}
ToggleSwitch::track:checked {
	background: rounded-rect($primary, radius=12, border=$primary, border-width=1);
}
ToggleSwitch::knob {
	background: rounded-rect(#eff0f1, radius=10);
}

/* === ComboBox === */

ComboBox {
	background: rounded-rect($surface-bright, radius=2, border=$border, border-width=1);
	corner-radius: 2;
}
ComboBox::arrow {
	text-color: #b6bbc2;
	background: svg(arrow-down);
}

/* === ScrollBar === */

ScrollBar::track {
	background: color(rgba(55, 58, 61, 0.6));
}
ScrollBar::thumb {
	background: rounded-rect(#4085a9, radius=3);
}

/* === Separator === */

Separator {
	border-color: $surface;
}

/* === Expander === */

Expander::header {
	background: rounded-rect(#2b3034, radius=2);
}
Expander::header:hover {
	background: rounded-rect(#334e5e, radius=2);
}
Expander::chevron {
	background: svg(chevron-right);
	text-color: #b6bbc2;
}
Expander::chevron:checked {
	background: svg(chevron-down);
}

/* === TabView === */

TabView::strip {
	background: color(#2b3034);
}
TabView::content {
	background: color($surface);
}
TabView::tab {
	text-color: #c0c5cc;
}
TabView::tab:checked {
	background: color($surface);
	text-color: white;
}
TabView::tab:hover {
	background: color(#334e5e);
	text-color: white;
}
TabView::close-button {
	background: svg(close);
	text-color: #909396;
	width: 12;
}
TabView::close-button:hover {
	text-color: #863d47;
}
TabView {
	border-color: #616569;
	accent-color: $primary;
}

/* === ContextMenu === */

.contextmenu {
	background: rounded-rect(#2d3136, radius=2, border=#616569, border-width=1);
	menu-item-hover-drawable: rounded-rect(#284150, radius=2);
	text-color: $text;
	border-color: #616569;
	accent-color: rgba(61, 174, 233, 0.4);
}

/* === Dialog === */

Dialog {
	background: rounded-rect($surface, radius=4, border=#616569, border-width=1);
}

/* === Tooltip === */

TooltipView {
	background: rounded-rect(#2d3136, radius=3, border=#616569, border-width=1);
	text-color: $text;
}

/* === ListView === */

ListView {
	background: color($background);
	selection-color: rgba(61, 174, 233, 0.3);
}

/* === TreeView === */

TreeView {
	background: color($background);
}
TreeView::chevron {
	background: svg(chevron-right);
}
TreeView::chevron:checked {
	background: svg(chevron-down);
}

/* === GridView === */

GridView {
	background: color($background);
	selection-color: rgba(61, 174, 233, 0.3);
}

/* === Global icons === */

NumericField::arrow-up {
	background: svg(arrow-up);
}
NumericField::arrow-down {
	background: svg(arrow-down);
}
.contextmenu::submenu-arrow {
	background: svg(chevron-right);
}
