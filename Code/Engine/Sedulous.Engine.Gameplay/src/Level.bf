using System;
using System.Collections;
using System.Reflection;
using Sedulous.Core.Serialization;
using Sedulous.Resource;
using Sedulous.Run;
using Sedulous.Scene;
using Sedulous.Engine.GameInstance;
using internal Sedulous.Engine.Gameplay;
using internal Sedulous.Engine.GameInstance;

namespace Sedulous.Engine.Gameplay;

/// Per scene game code: a class whose one instance is a system of its scene, its public fields
/// the scene's settings block for it, which the scene saves and the inspector shows when no
/// entity is selected.
///
/// A subclass carries [Level] (its id on disk and its data version) and is registered with
/// GameplayServices.AddLevel, which puts it in every scene. A scene chooses it by turning on its
/// Active, saved first in its block; a scene that leaves it off runs nothing of it, so one game
/// may register several levels and each scene runs the ones it turned on.
///
/// SIMULATION ONLY, and only while Active. Each frame's Update settles the edge first: OnStart
/// when it is active and has not started, OnStop when it has started and is no longer active.
/// Then OnUpdate, when it has started and is still active. OnFixedStep runs on the scene's
/// fixed step, which runs before the frame's Update, so the first frame's fixed steps come
/// before OnStart and do not reach it. Turning Active off and on again mid-run stops it and
/// starts it again, its fields as they were left. OnStop also runs as the scene stops. A level
/// deleted while it runs (its scene torn down without stopping, or its plugin unloaded) gets no
/// OnStop: a subclass's own fields are gone by the time Level's destructor runs. Its
/// subscriptions and queued calls end then all the same.
///
/// It runs at UpdateOrder -111, before the scene's behaviours (-110), so what the
/// level sets in a frame is there for them in the same frame.
///
/// The scene's own hooks OnUpdate (with a phase), OnFixedUpdate and OnSceneStopped are the
/// level's driver: a subclass overrides OnStart, OnUpdate(dt), OnFixedStep and OnStop
/// instead, and GameplayServices.AddLevel refuses one that overrides the driver. (The fixed
/// hook is not called OnFixedUpdate, as a behaviour's is, because that is the scene's own
/// signature.)
///
/// The constructor and the field initialisers must not touch the scene: a default constructed
/// instance is also where the inspector reads a field's default, and it has no scene.
[Reflect(.NonStaticFields)]
abstract class Level : SceneSystem
{
	/// Before the behaviours at -110, and so before what acts on what game code
	/// writes (the navigation crowd at -100, animation at -2 and -1).
	public const int32 cUpdateOrder = -111;

	/// Whether this scene runs the level. Saved first in its block, so a scene that turned it
	/// on runs it when it loads. Written directly: the change takes effect, with its OnStart or
	/// OnStop, at the next tick.
	public bool Active = false;

	/// OnStart was delivered, so OnStop is owed.
	private bool mStarted = false;
	/// The run event subscriptions Listen made, ended as it stops. Null until the first.
	private List<EventSubscription> mSubscriptions = null ~ delete _;
	/// BORROWED: what the scene's resolve bound against, kept so a block read after it (an
	/// undo, an inspector edit) binds what it read.
	private ResourceManager mResources = null;

	public override int32 UpdateOrder => cUpdateOrder;
	public override bool IsSimulationOnly => true;

	// ---- its settings block is itself ----

	public override Type SettingsType => GetType();
	public override void* SettingsInstance => Internal.UnsafeCastToPtr(this);
	// SettingsId, the data versions and SerializeSettings are generated by [Level].

	/// Whether it has started and not stopped since: it is running.
	public bool Started => mStarted;

	/// The run its scene belongs to; null outside every run.
	public IRun Run => (Scene != null) ? Scene.Run : null;

	/// Its run's random numbers, the ones all of the run's game code draws; null outside a run
	/// that has them. BORROWED.
	public Sedulous.Core.RunRandom Random => RunServices.Get<Sedulous.Core.RunRandom>(Run);

	/// Lets go of the run without OnStop, which would run on a subclass already torn down:
	/// nothing it subscribed or queued outlives it.
	public ~this()
	{
		mStarted = false;
		EndSubscriptionsAndCalls();
	}

	// ---- events and queued calls ----

	/// Calls `handler` with every `T` emitted or posted in its run (GameEvents), while it runs:
	/// started and active. The subscription ends as it stops, a handler stopping it included.
	/// TAKES OWNERSHIP of `handler`; false, the handler deleted, outside a run.
	public bool Listen<T>(delegate void(T) handler) where T : struct
	{
		let run = Run;
		if (run == null)
		{
			delete handler;
			return false;
		}
		delegate void(T) gated = new [=this, =handler] (evt) =>
			{
				if (!mStarted || !Active)
					return;
				// Marked as scene code for its run, so a LoadScene from it defers rather than
				// destroying this level's scene, and this level, under it.
				let game = RunServices.Get<GameInstance>(Run);
				if (game != null)
					game.EnterSceneCode();
				handler(evt);
				if (game != null)
					game.LeaveSceneCode();
			} ~ delete handler;
		let subscription = GameEvents.Listen<T>(run, gated);
		if (!subscription.IsSubscribed)
			return false;
		if (mSubscriptions == null)
			mSubscriptions = new .();
		mSubscriptions.Add(subscription);
		return true;
	}

	/// GameEvents.Emit in its run: delivered now.
	public void Emit<T>(T evt) where T : struct => GameEvents.Emit<T>(Run, evt);

	/// GameEvents.Post in its run: delivered at the run's next drain.
	public void Post<T>(T evt) where T : struct => GameEvents.Post<T>(Run, evt);

	/// Queues `call` for the end of its scene's next tick (BehaviourSystem.Post), bound to this
	/// level: stopped before then, the call does not run. TAKES OWNERSHIP of `call`; false, the
	/// call deleted, outside a scene with a BehaviourSystem (a game that registers no
	/// behaviour has none).
	public bool Post(delegate void() call)
	{
		let system = (Scene != null) ? Scene.GetSystem<BehaviourSystem>() : null;
		if (system == null)
		{
			delete call;
			return false;
		}
		system.Post(this, call);
		return true;
	}

	// ---- resources ----

	/// Binds its asset references against `manager`, kept for a block read after: the scene's
	/// resolve pass reaches every system, a level among them.
	public override void ResolveResources(ResourceManager manager)
	{
		mResources = manager;
		if (manager != null)
			BindReferences(manager);
	}

	/// Binds the Ref<T> fields it saves: generated by [Level] for a class that has any.
	protected virtual void BindReferences(ResourceManager manager) {}

	/// After its block is read: bound at once when the scene was resolved before.
	protected void RebindAfterRead()
	{
		if (mResources != null)
			BindReferences(mResources);
	}

	// ---- lifecycle, simulation only, while Active ----

	/// When it starts: its first tick while active, and again after each stop.
	protected virtual void OnStart() {}
	/// Every frame while it runs, after the edge.
	protected virtual void OnUpdate(float dt) {}
	/// On the fixed step physics runs on, while it runs.
	protected virtual void OnFixedStep(float dt) {}
	/// When it stops: no longer active, or its scene stopped. Its subscriptions and queued
	/// calls end after it returns.
	protected virtual void OnStop() {}

	// ---- the driver ----

	public override void OnUpdate(ScenePhase phase, float deltaTime)
	{
		if (phase != .Update)
			return;
		if (Active && !mStarted)
		{
			mStarted = true;
			OnStart();
		}
		else if (!Active && mStarted)
		{
			Stop();
		}
		// Re-checked: OnStart may have turned it off, and then the stop waits for the next tick.
		if (mStarted && Active)
			OnUpdate(deltaTime);
	}

	public override void OnFixedUpdate(float fixedDeltaTime)
	{
		if (mStarted && Active)
			OnFixedStep(fixedDeltaTime);
	}

	/// A stopped scene stops its level: nothing of one play reaches the next, which starts it
	/// again on its first tick.
	public override void OnSceneStopped()
	{
		if (mStarted)
			Stop();
	}

	/// OnStop, then its subscriptions end and its queued calls are dropped, after anything
	/// OnStop did: nothing reaches it once it has stopped. The flag is cleared first, so a stop
	/// that reaches it again runs nothing twice.
	private void Stop()
	{
		if (!mStarted)
			return;
		mStarted = false;
		OnStop();
		EndSubscriptionsAndCalls();
	}

	/// Ends its subscriptions and drops its queued calls.
	private void EndSubscriptionsAndCalls()
	{
		if (mSubscriptions != null)
		{
			for (var subscription in ref mSubscriptions)
				subscription.Dispose();
			mSubscriptions.Clear();
		}
		if (Scene != null)
		{
			if (let system = Scene.GetSystem<BehaviourSystem>())
				system.DropCalls(this);
		}
	}

	/// What GameplayServices.AddLevel checks of `type` at compile time: it carries [Level], and
	/// overrides none of the scene hooks the level drives itself, which would run it outside
	/// its gating. Each refusal is a compile error naming the class. The unspecialized generic
	/// (a generic parameter, not a class) is passed over: it is never built.
	[Comptime]
	internal static void EmitChecks(Type type)
	{
		if (!(type is TypeInstance) || type.IsGenericParam)
			return;
		if (!(type.GetCustomAttribute<LevelAttribute>() case .Ok))
		{
			let message = scope String();
			type.GetFullName(message);
			message.Append(" is registered as a Level but carries no [Level] attribute");
			Runtime.FatalError(message);
		}
		RefuseDriverOverride(type, "OnUpdate", 2, typeof(ScenePhase), "OnUpdate(float dt)");
		RefuseDriverOverride(type, "OnFixedUpdate", 1, typeof(float), "OnFixedStep(float dt)");
		RefuseDriverOverride(type, "OnSceneStopped", 0, null, "OnStop()");
	}

	/// Refuses, as a compile error naming the method, a `name` (`paramCount` parameters, the
	/// first a `firstParam` when there is one) declared below Level.
	[Comptime]
	private static void RefuseDriverOverride(Type type, StringView name, int paramCount, Type firstParam, StringView instead)
	{
		let instance = type as TypeInstance;
		if (instance == null)
			return;
		for (let method in instance.GetMethods(.Instance | .Public | .NonPublic))
		{
			if ((method.Name != name) || (method.ParamCount != paramCount))
				continue;
			if ((paramCount > 0) && (method.GetParamType(0) != firstParam))
				continue;
			if ((method.DeclaringType == typeof(Level)) || (method.DeclaringType == typeof(SceneSystem)))
				continue;
			let message = scope String();
			type.GetFullName(message);
			message.Append(" overrides ");
			message.Append(name);
			message.Append(", which drives the level; override ");
			message.Append(instead);
			message.Append(" instead");
			Runtime.FatalError(message);
		}
	}
}
