using System;
using Sedulous.Core;
using Sedulous.Run;
using Sedulous.Scene;

namespace Sedulous.Engine.Gameplay;

/// Per entity game code: a class whose instance rides one entity, its public fields the data a
/// scene saves and an inspector edits, its private ones runtime state.
///
/// A subclass carries [Behaviour] (its id on disk and its data version) and is stored by a
/// BehaviourManager of its own type, which OWNS the instance: it makes it when the entity gets
/// one, and deletes it when the behaviour is removed, its entity destroyed or the scene torn
/// down. Re-reading a saved record makes a fresh instance, so no runtime state survives one.
///
/// The constructor and the field initialisers must not touch the scene: a default constructed
/// instance is also where the inspector reads a field's default, and it has no scene.
abstract class Behaviour
{
	/// BORROWED: the scene outlives its managers, and so their instances.
	private Scene mScene = null;
	private EntityHandle mEntity = .Invalid;

	/// OnStart was delivered, so OnDestroy is owed.
	internal bool mStarted = false;
	/// The enable state last delivered (OnEnable or OnDisable), the edge the lifecycle
	/// compares IsActive with.
	internal bool mEnabledDelivered = false;

	/// Whether it runs. Saved with the rest of its data, so one disabled in a scene stays
	/// disabled when the scene loads. Written directly: the change takes effect, with its
	/// OnEnable or OnDisable, at the next tick.
	public bool Enabled = true;

	/// The scene it is in; null before its manager attaches it and while its manager tears
	/// down.
	public Scene Scene => mScene;

	/// The entity it rides.
	public EntityHandle Entity => mEntity;

	/// The run its scene belongs to; null outside every run.
	public IRun Run => (mScene != null) ? mScene.Run : null;

	/// Enabled, and its entity active with all its ancestors.
	public bool IsActive => Enabled && (mScene != null) && mScene.IsEffectivelyActive(mEntity);

	/// The LIVE `T` component on this entity, or null without one. As transient as
	/// Scene.GetComponent: re-ask after anything that adds or removes a `T`.
	public T* Get<T>() where T : struct
		=> (mScene != null) ? mScene.GetComponent<T>(mEntity) : null;

	/// This entity's `B` behaviour, or null without one (or without a manager for `B` in
	/// this scene). BORROWED: its manager deletes it when it goes.
	public B Get<B>() where B : Behaviour
	{
		if (mScene == null)
			return null;
		let manager = mScene.ManagerForComponent(typeof(B));
		if (manager == null)
			return null;
		let address = manager.GetComponentAddress(mEntity);
		return (address != null) ? (B)Internal.UnsafeCastToObject(address) : null;
	}

	/// The stored fields, generated by [Behaviour]: its public fields, in declaration order,
	/// base first (Enabled leads). The manager brackets it with the record's version.
	public virtual void Serialize(Sedulous.Core.Serialization.ISerializer ar) {}

	// ---- lifecycle, simulation only ----

	/// The behaviour became active: enabled on an active entity.
	protected virtual void OnEnable() {}
	/// Once, before its first update.
	protected virtual void OnStart() {}
	protected virtual void OnUpdate(float dt) {}
	/// On the fixed step physics runs on.
	protected virtual void OnFixedUpdate(float dt) {}
	/// After every update of the frame: what follows what moved (a camera).
	protected virtual void OnLateUpdate(float dt) {}
	/// The behaviour stopped being active: disabled, or its entity deactivated.
	protected virtual void OnDisable() {}
	/// Before it is deleted, when it had started, and after OnDisable when it was enabled.
	/// It still has its scene, and its entity's components: removal, the entity's
	/// destruction and the scene's teardown all run it before anything else goes.
	protected virtual void OnDestroy() {}

	/// Two bodies began touching, `other` the far side's entity; `speed` is the closing speed
	/// along `normal`.
	protected virtual void OnContactBegin(EntityHandle other, Float3 point, Float3 normal, float speed) {}
	protected virtual void OnContactEnd(EntityHandle other, Float3 point, Float3 normal, float speed) {}
	/// `other` entered or left a trigger volume on this entity, or this one entered or left
	/// `other`'s.
	protected virtual void OnTriggerEnter(EntityHandle other) {}
	protected virtual void OnTriggerExit(EntityHandle other) {}

	// ---- the manager's ----

	internal void Attach(Scene scene, EntityHandle entity)
	{
		mScene = scene;
		mEntity = entity;
	}

	internal void Detach()
	{
		mScene = null;
	}

	/// Whether a tick reaches it: started, its enable delivered, and active now. One that
	/// went inactive since the last edges is skipped until those deliver its OnDisable.
	internal bool Ticks => mStarted && mEnabledDelivered && IsActive;

	/// The enable edges, once per frame before the updates: OnEnable when it became active
	/// (then OnStart, the first time), OnDisable when it stopped being. A removed instance is
	/// detached and released, so it is never active and has nothing delivered: nothing runs.
	internal void SettleEnabled()
	{
		if (IsActive)
		{
			if (!mEnabledDelivered)
			{
				mEnabledDelivered = true;
				OnEnable();
			}
			// Re-checked: OnEnable may have disabled it, and then the start waits for the
			// next time it is enabled.
			if (!mStarted && mEnabledDelivered && IsActive)
			{
				mStarted = true;
				OnStart();
			}
		}
		else if (mEnabledDelivered)
		{
			mEnabledDelivered = false;
			OnDisable();
		}
	}

	/// What its manager runs before deleting it, and the one place the closing edges run:
	/// OnDisable when its enable was delivered, then OnDestroy when it had started. Each flag
	/// is cleared before its call, so a removal that reaches it again runs nothing twice.
	internal void Release()
	{
		if (mEnabledDelivered)
		{
			mEnabledDelivered = false;
			OnDisable();
		}
		if (mStarted)
		{
			mStarted = false;
			OnDestroy();
		}
	}
}
