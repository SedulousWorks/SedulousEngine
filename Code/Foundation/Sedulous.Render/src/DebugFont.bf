using System;
using System.Collections;
using Sedulous.Core;

namespace Sedulous.Render;

/// The embedded eight by eight bitmap font the debug text is drawn with.
///
/// Printable ASCII only, from space to tilde. The data is eight bytes per glyph, one per row,
/// with the HIGH bit the leftmost pixel. It is baked at runtime into a single channel atlas
/// with a solid white block after the last glyph, which is what the filled rectangles sample.
static class DebugFont
{
	public const int cCharWidth = 8;
	public const int cCharHeight = 8;
	/// Space.
	public const int cFirstChar = 32;
	/// Tilde.
	public const int cLastChar = 126;
	public const int cCharCount = cLastChar - cFirstChar + 1;
	public const int cCharsPerRow = 16;
	public const int cTextureWidth = cCharsPerRow * cCharWidth;
	public const int cTextureHeight =
		((cCharCount + cCharsPerRow - 1) / cCharsPerRow) * cCharHeight;

	public const uint8[cCharCount * 8] cFontData = .(
		0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, // ' ' (32)
		0x18, 0x18, 0x18, 0x18, 0x18, 0x00, 0x18, 0x00, // ! (33)
		0x6C, 0x6C, 0x24, 0x00, 0x00, 0x00, 0x00, 0x00, // " (34)
		0x6C, 0x6C, 0xFE, 0x6C, 0xFE, 0x6C, 0x6C, 0x00, // # (35)
		0x18, 0x7E, 0xC0, 0x7C, 0x06, 0xFC, 0x18, 0x00, // $ (36)
		0x00, 0xC6, 0xCC, 0x18, 0x30, 0x66, 0xC6, 0x00, // % (37)
		0x38, 0x6C, 0x38, 0x76, 0xDC, 0xCC, 0x76, 0x00, // & (38)
		0x18, 0x18, 0x30, 0x00, 0x00, 0x00, 0x00, 0x00, // ' (39)
		0x0C, 0x18, 0x30, 0x30, 0x30, 0x18, 0x0C, 0x00, // ( (40)
		0x30, 0x18, 0x0C, 0x0C, 0x0C, 0x18, 0x30, 0x00, // ) (41)
		0x00, 0x66, 0x3C, 0xFF, 0x3C, 0x66, 0x00, 0x00, // * (42)
		0x00, 0x18, 0x18, 0x7E, 0x18, 0x18, 0x00, 0x00, // + (43)
		0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x30, // , (44)
		0x00, 0x00, 0x00, 0x7E, 0x00, 0x00, 0x00, 0x00, // - (45)
		0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x00, // . (46)
		0x06, 0x0C, 0x18, 0x30, 0x60, 0xC0, 0x80, 0x00, // / (47)
		0x7C, 0xCE, 0xDE, 0xF6, 0xE6, 0xC6, 0x7C, 0x00, // 0 (48)
		0x18, 0x38, 0x18, 0x18, 0x18, 0x18, 0x7E, 0x00, // 1 (49)
		0x7C, 0xC6, 0x06, 0x1C, 0x70, 0xC6, 0xFE, 0x00, // 2 (50)
		0x7C, 0xC6, 0x06, 0x3C, 0x06, 0xC6, 0x7C, 0x00, // 3 (51)
		0x1C, 0x3C, 0x6C, 0xCC, 0xFE, 0x0C, 0x1E, 0x00, // 4 (52)
		0xFE, 0xC0, 0xFC, 0x06, 0x06, 0xC6, 0x7C, 0x00, // 5 (53)
		0x38, 0x60, 0xC0, 0xFC, 0xC6, 0xC6, 0x7C, 0x00, // 6 (54)
