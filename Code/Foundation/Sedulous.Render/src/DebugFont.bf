		0x00, 0x00, 0xC6, 0xC6, 0xC6, 0xC6, 0x7E, 0x00, // u (117)
		0x00, 0x00, 0xC6, 0xC6, 0xC6, 0x6C, 0x38, 0x00, // v (118)
		0x00, 0x00, 0xC6, 0xC6, 0xD6, 0xFE, 0x6C, 0x00, // w (119)
		0x00, 0x00, 0xC6, 0x6C, 0x38, 0x6C, 0xC6, 0x00, // x (120)
		0x00, 0x00, 0xC6, 0xC6, 0xC6, 0x7E, 0x06, 0x7C, // y (121)
		0x00, 0x00, 0xFE, 0x0C, 0x38, 0x60, 0xFE, 0x00, // z (122)
		0x0E, 0x18, 0x18, 0x70, 0x18, 0x18, 0x0E, 0x00, // { (123)
		0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x00, // | (124)
		0x70, 0x18, 0x18, 0x0E, 0x18, 0x18, 0x70, 0x00, // } (125)
		0x76, 0xDC, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00  // ~ (126)
		);

	/// Bakes the font into a single channel atlas. The slot after the last glyph is filled
	/// solid, which is what a filled rectangle samples.
	public static void GenerateTextureData(List<uint8> outData)
	{
		outData.Clear();
		outData.Resize(cTextureWidth * cTextureHeight);
		for (int i < outData.Count)
			outData[i] = 0;

		for (int glyph < cCharCount)
		{
			let baseX = (glyph % cCharsPerRow) * cCharWidth;
			let baseY = (glyph / cCharsPerRow) * cCharHeight;

			for (int row < cCharHeight)
			{
				let rowBits = cFontData[glyph * 8 + row];
				for (int col < cCharWidth)
				{
					let bit = (rowBits >> (7 - col)) & 1;
					outData[(baseY + row) * cTextureWidth + (baseX + col)] = (bit != 0) ? 255 : 0;
				}
			}
		}

		let solidX = (cCharCount % cCharsPerRow) * cCharWidth;
		let solidY = (cCharCount / cCharsPerRow) * cCharHeight;
		for (int row < cCharHeight)
		{
			for (int col < cCharWidth)
			{
				let x = solidX + col;
				let y = solidY + row;
				if ((x < cTextureWidth) && (y < cTextureHeight))
					outData[y * cTextureWidth + x] = 255;
			}
		}
	}

	/// The solid block's coordinates, as an origin and an opposite corner.
	public static Float4 SolidBlockUV => CellUV(cCharCount);

	/// A printable character's coordinates. False, and an empty rectangle, when it is outside
	/// the range the font covers.
	public static bool TryGetCharUV(char32 c, out Float4 uv)
	{
		uv = .(0, 0, 0, 0);
		if (((int)c < cFirstChar) || ((int)c > cLastChar))
			return false;

		uv = CellUV((int)c - cFirstChar);
		return true;
	}

	private static Float4 CellUV(int index)
	{
		let col = index % cCharsPerRow;
		let row = index / cCharsPerRow;
		return .(
			(float)(col * cCharWidth) / (float)cTextureWidth,
			(float)(row * cCharHeight) / (float)cTextureHeight,
			(float)((col + 1) * cCharWidth) / (float)cTextureWidth,
			(float)((row + 1) * cCharHeight) / (float)cTextureHeight);
	}
}
