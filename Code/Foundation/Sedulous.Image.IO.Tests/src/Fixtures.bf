using System;

namespace Sedulous.Image.IO.Tests;

/// Real encoded images, embedded as bytes.
///
/// Generated rather than checked in as files, and small enough to read: a decoder test
/// needs genuine encoded input, and a fixture file would make these tests depend on a
/// working directory.
static class Fixtures
{
