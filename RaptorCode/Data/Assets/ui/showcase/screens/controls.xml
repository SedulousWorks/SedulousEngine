<!-- Controls (E12 of gui-lab-evolution-2.md): each action's key, rebound by choosing it and pressing
     a key or a pad button; Escape cancels, and a key another action had swaps. -->
<Screen class="menu-page" covers="true" flex-direction="column" align-items="center">
    <Panel class="panel glass controls" flex-direction="column" align-items="center" gap="10">
        <Label class="panel-title" text="@menu.controls"/>
        <Panel class="row" flex-direction="row" align-items="start" gap="14">
            <Label class="row-label wide" text="@controls.jump"/>
            <Button id="bind-jump" class="bind-btn" text="{{key-jump}}"/>
        </Panel>
        <Panel class="row" flex-direction="row" align-items="start" gap="14">
            <Label class="row-label wide" text="@controls.dash"/>
            <Button id="bind-dash" class="bind-btn" text="{{key-dash}}"/>
        </Panel>
        <Panel class="row" flex-direction="row" align-items="start" gap="14">
            <Label class="row-label wide" text="@controls.interact"/>
            <Button id="bind-interact" class="bind-btn" text="{{key-interact}}"/>
        </Panel>
        <Panel class="row" flex-direction="row" align-items="start" gap="14">
            <Label class="row-label wide" text="@controls.map"/>
            <Button id="bind-map" class="bind-btn" text="{{key-map}}"/>
        </Panel>
        <Label class="controls-hint" text="{{controls-hint}}"/>
        <Button id="controls-back" class="menu-btn small" text="@menu.back"/>
    </Panel>
</Screen>
